# Supabase configuration (optional - defaults to local storage if unset)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias:
# VITE_SUPABASE_ANON_KEY=

# Feature flags
VITE_FEATURE_CLASSROOM_IMPORT=false

# Google Classroom API (optional - enabled when VITE_FEATURE_CLASSROOM_IMPORT=true)
# OAuth 2.0 Client ID from Google Cloud Console (Web application)
VITE_GOOGLE_CLIENT_ID=
# Optional Google API Key
VITE_GOOGLE_API_KEY=

# Test runner configuration (optional system chromium executable override for NixOS)
PLAYWRIGHT_LAUNCH_OPTIONS_EXECUTABLE_PATH=
